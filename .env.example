# ThreatFeed Environment Variables

# Database
THREATFEED_DB_PATH=data/threats.db
THREATFEED_DB_TYPE=sqlite
# For PostgreSQL:
# THREATFEED_DB_URL=postgresql://user:password@localhost:5432/threatfeed

# Logging
THREATFEED_LOG_LEVEL=INFO
THREATFEED_LOG_FILE=threatfeed.log

# Aggregation
THREATFEED_FETCH_INTERVAL_MINUTES=60
THREATFEED_DATA_RETENTION_DAYS=90
THREATFEED_DEDUP_THRESHOLD=0.7

# Dashboard
THREATFEED_DASHBOARD_HOST=0.0.0.0
THREATFEED_DASHBOARD_PORT=8000
THREATFEED_DASHBOARD_AUTO_REFRESH_MINUTES=5

# MCP Server
THREATFEED_MCP_DEFAULT_LIMIT=50
THREATFEED_MCP_DEFAULT_DAYS=7

# Notifications (optional)
THREATFEED_SLACK_WEBHOOK=
THREATFEED_EMAIL_ENABLED=false
THREATFEED_ALERT_ON_CRITICAL=true

# Sources (enable/disable)
THREATFEED_SOURCE_BLEEPING_COMPUTER=true
THREATFEED_SOURCE_PALO_ALTO=true
THREATFEED_SOURCE_HACKERNEWS=true
THREATFEED_SOURCE_CUSTOM=false
